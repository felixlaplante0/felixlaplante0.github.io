---
import { getCollection, render } from "astro:content";
import { monthYear, newestFirst } from "../lib/dates";

const talks = (await getCollection("talks")).sort(newestFirst);
const rendered = await Promise.all(talks.map(async (talk) => ({ ...talk.data, ...(await render(talk)) })));
const locale = Astro.currentLocale ?? "en";
const french = locale === "fr";
const kinds = { Talk: "Exposé", Poster: "Affiche" };
---

{rendered.map(({ title, kind, event, place, date, descriptionFr, Content }) => (
  <article class="entry">
    <h3 lang="en">{title}</h3>
    <p class="venue">{french ? kinds[kind] : kind} · <em>{event}</em>, {place}, {monthYear(date, locale)}</p>
    {french ? <p>{descriptionFr}</p> : <Content />}
  </article>
))}
