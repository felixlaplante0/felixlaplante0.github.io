---
interface Props {
  lat: number;
  lng: number;
  zoom?: number;
  label: string;
}

const { lat, lng, zoom = 16, label } = Astro.props;
---

<div class="map" role="region" aria-label={label} data-lat={lat} data-lng={lng} data-zoom={zoom}></div>

<script>
  import { Map as MapLibreMap, Marker, NavigationControl } from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  let activeMap: MapLibreMap | undefined;

  function initMap() {
    const el = document.querySelector<HTMLElement>(".map[data-lat]");
    if (!el || el.dataset.ready) return;
    el.dataset.ready = "true";

    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);
    const zoom = Number(el.dataset.zoom ?? 16);

    activeMap = new MapLibreMap({
      container: el,
      style: "https://tiles.openfreemap.org/styles/liberty",
      center: [lng, lat],
      zoom,
    });

    activeMap.addControl(new NavigationControl({ showCompass: false }), "top-right");
    new Marker({ color: "#0f4c81" }).setLngLat([lng, lat]).addTo(activeMap);
  }

  document.addEventListener("astro:page-load", initMap);
  document.addEventListener("astro:before-swap", () => {
    activeMap?.remove();
    activeMap = undefined;
  });
</script>
