---
import { Font } from "astro:assets";
import { Icon } from "astro-icon/components";
import { pages, socials, title as site } from "../site";
import "../styles/global.css";

const { title } = Astro.props.frontmatter;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site ? site : `${title} – ${site}`}</title>
    <link rel="icon" href="/assets/logo.svg" />
    <link rel="canonical" href={Astro.url} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-heading" />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo"><img src="/assets/logo.svg" alt={site} /></a>
        <ul class="pages">
          {pages.map(({ href, label }) => (
            <li><a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a></li>
          ))}
        </ul>
        <ul class="socials">
          {socials.map(({ href, label, icon }) => (
            <li><a href={href} aria-label={label} title={label}><Icon name={icon} /></a></li>
          ))}
          <li><button id="theme" aria-label="Toggle dark mode" title="Toggle dark mode"><Icon name="bi:sun" class="light" /><Icon name="bi:moon-stars" class="dark" /></button></li>
        </ul>
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <script>
      import Headroom from "headroom.js";

      new Headroom(document.querySelector("header")!, { tolerance: 5 }).init();

      const root = document.documentElement;
      document.getElementById("theme")!.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        localStorage.setItem("theme", root.dataset.theme);
      });
    </script>
  </body>
</html>
