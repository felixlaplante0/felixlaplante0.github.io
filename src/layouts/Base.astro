---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
import { pages, socials, title as site } from "../site";
import "../styles/global.css";

const { title } = Astro.props.frontmatter;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site ? site : `${title} – ${site}`}</title>
    <link rel="icon" href="/assets/logo.svg" />
    <link rel="canonical" href={Astro.url} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-heading" />
    <ClientRouter />
    <script is:inline>
      const setTheme = (doc) => (doc.documentElement.dataset.theme = localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
      setTheme(document);
      document.addEventListener("astro:before-swap", (e) => setTheme(e.newDocument));
    </script>
  </head>
  <body>
    <header transition:persist>
      <nav>
        <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="menu"><Icon name="bi:list" /></button>
        <a href="/" class="logo"><img src="/assets/logo.svg" alt={site} /></a>
        <div id="menu">
          <ul class="pages">
            {pages.map(({ href, label }) => (
              <li><a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
          <ul class="socials">
            {socials.map(({ href, label, icon }) => (
              <li><a href={href} aria-label={label} title={label}><Icon name={icon} /></a></li>
            ))}
          </ul>
        </div>
        <button id="theme" aria-label="Toggle dark mode" title="Toggle dark mode"><Icon name="bi:sun" class="light" /><Icon name="bi:moon-stars" class="dark" /></button>
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <script>
      import Headroom from "headroom.js";

      new Headroom(document.querySelector("header")!, { tolerance: 5 }).init();

      const toggle = document.querySelector(".menu-toggle")!;
      toggle.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true"));
      });

      document.addEventListener("astro:page-load", () => {
        toggle.setAttribute("aria-expanded", "false");
        for (const a of document.querySelectorAll<HTMLAnchorElement>(".pages a")) {
          if (a.pathname === location.pathname) a.setAttribute("aria-current", "page");
          else a.removeAttribute("aria-current");
        }
      });

      const root = document.documentElement;
      document.getElementById("theme")!.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        localStorage.setItem("theme", root.dataset.theme);
      });
    </script>
  </body>
</html>
